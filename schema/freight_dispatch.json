{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFreightDispatch",
  "description": "Schema for Open Freight Logistics & Dispatch Protocol (OPEN-FREIGHT-v1.0)",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "OPEN-FREIGHT-v1.0"
    },
    "object_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_type": {
      "type": "string",
      "enum": ["freight_tender", "shipment_leg", "carrier_attestation", "bill_of_lading", "telemetry_ping"]
    },
    "local_state_vector": {
      "type": "object",
      "properties": {
        "state_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "timestamp_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["state_hash", "timestamp_epoch"]
    },
    "relations_graph": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "security_invariants": {
      "type": "object",
      "properties": {
        "isolated_sandbox_required": {
          "type": "boolean",
          "const": true
        },
        "statutory_compliance_verified": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["isolated_sandbox_required", "statutory_compliance_verified"]
    }
  },
  "required": [
    "protocol_version",
    "object_id",
    "entity_type",
    "local_state_vector",
    "relations_graph",
    "security_invariants"
  ]
}
