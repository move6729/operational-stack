{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenticCollectiveLaborLeverage",
  "type": "object",
  "required": [
    "collective_id",
    "sector_code",
    "min_rate_floor_cents",
    "signed_proof_hashes",
    "activation_threshold"
  ],
  "properties": {
    "collective_id": {
      "type": "string",
      "pattern": "^LABOR-[0-9a-f]{8}$"
    },
    "sector_code": {
      "type": "string"
    },
    "min_rate_floor_cents": {
      "type": "integer",
      "minimum": 0
    },
    "signed_proof_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "activation_threshold": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
