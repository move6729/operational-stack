          "properties": {
            "C_Secret": { "type": "number", "const": 0.0 },
            "A_Public": { "type": "number", "const": 1.0 },
            "I_Verified": { "type": "number", "const": 1.0 },
            "Opacity_Rent": { "type": "number", "const": 0.0 },
