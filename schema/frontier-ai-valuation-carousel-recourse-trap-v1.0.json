{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opstack:schema:frontier-ai-valuation-carousel-recourse-trap-v1.0.json",
  "title": "Frontier AI Valuation Carousel Recourse Trap",
  "type": "object",
  "required": [
    "canonical_spec_id",
    "jurisdiction_context",
    "cfaa_compliance_attestation",
    "entity_and_instrument_ids",
    "valuation_carousel_and_asc606_audit",
    "ml_telemetry_scienter_and_dno_voidance",
    "capital_stack_tranche_waterfall",
    "gp_founder_prisoners_dilemma",
    "catalyst_calendar"
  ],
  "properties": {
    "canonical_spec_id": {
      "const": "SPEC-FRONTIER-AI-VALUATION-CAROUSEL-RECOURSE-TRAP-v1.0"
    },
    "jurisdiction_context": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "ISO 3166-1 jurisdiction code (with optional subdivision)."
    },
    "cfaa_compliance_attestation": {
      "const": true,
      "description": "Attestation that the analysis relies solely on public records and authorized access (18 U.S.C. 1030 compliant)."
    },
    "entity_and_instrument_ids": {
      "type": "object",
      "required": ["primary_target", "bdc_co_lenders", "insurance_sidecar_counterparties", "auditors_valuation_agents", "public_pension_lps", "trustees_agents_and_counsel"],
      "properties": {
        "primary_target": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["legal_name", "role"],
            "properties": {
              "legal_name": {"type": "string"},
              "ticker": {"type": ["string", "null"]},
              "cik": {"type": ["string", "null"], "pattern": "^[0-9]{10}$"},
              "crd": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
              "court_dockets": {"type": "array", "items": {"type": "string"}},
              "role": {"type": "string"}
            }
          }
        },
        "bdc_co_lenders": {
          "type": "array",
          "items": {"type": "object", "properties": {"ticker": {"type": "string"}, "cik": {"type": ["string", "null"]}}}
        },
        "insurance_sidecar_counterparties": {
          "type": "array",
          "items": {"type": "object", "properties": {"naic_code": {"type": ["string", "null"]}}}
        },
        "auditors_valuation_agents": {
          "type": "array",
          "items": {"type": "object", "properties": {"pcacb_firm_id": {"type": ["string", "null"]}}}
        },
        "public_pension_lps": {"type": "array", "items": {"type": "object"}},
        "trustees_agents_and_counsel": {"type": "array", "items": {"type": "object"}}
      }
    },
    "valuation_carousel_and_asc606_audit": {
      "type": "object",
      "required": ["headline_post_money_valuation_m", "asc_606_phantom_gross_revenue_disallowed_m", "round_trip_valuation_haircut_m", "true_cash_equivalent_enterprise_value_m", "asc_820_headline_to_cash_distortion_multiple"],
      "properties": {
        "headline_post_money_valuation_m": {"type": "number", "exclusiveMinimum": 0},
        "asc_606_phantom_gross_revenue_disallowed_m": {"type": "number", "minimum": 0},
        "vendor_true_marginal_watt_silicon_cost_m": {"type": "number", "minimum": 0},
        "round_trip_valuation_haircut_m": {"type": "number", "minimum": 0},
        "goodhart_benchmark_contamination_penalty_m": {"type": "number", "minimum": 0},
        "true_cash_equivalent_enterprise_value_m": {"type": "number", "minimum": 0},
        "asc_820_headline_to_cash_distortion_multiple": {"type": "number", "minimum": 1}
      }
    },
    "ml_telemetry_scienter_and_dno_voidance": {
      "type": "object",
      "required": ["prior_probability", "likelihood_ratios", "posterior_prob", "dno_effective_coverage_m", "post_recourse_founder_net_utility_m"],
      "properties": {
        "prior_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "likelihood_ratios": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 1}},
        "posterior_odds": {"type": "number", "minimum": 0},
        "posterior_prob": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rescission_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "dno_exclusion_triggers": {"type": "boolean"},
        "dno_effective_coverage_m": {"type": "number", "minimum": 0},
        "post_recourse_founder_net_utility_m": {"type": "number"}
      }
    },
    "capital_stack_tranche_waterfall": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tranche_name", "principal_m", "seniority_rank"],
        "properties": {
          "tranche_name": {"type": "string"},
          "principal_m": {"type": "number", "exclusiveMinimum": 0},
          "coupon_pct": {"type": ["number", "null"], "minimum": 0},
          "coupon_pik_pct": {"type": ["number", "null"], "minimum": 0},
          "liquidation_pref_multiple": {"type": ["number", "null"], "minimum": 1},
          "seniority_rank": {"type": "integer", "minimum": 1},
          "recovery_at_stress_ev": {
            "type": "object",
            "properties": {
              "ev_m": {"type": "number"},
              "recovery_m": {"type": "number", "minimum": 0},
              "cents_on_dollar": {"type": "number", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    },
    "gp_founder_prisoners_dilemma": {
      "type": "object",
      "required": ["vc_gp_5yr_fee_annuity_m", "gp_payoff_defect_scapegoat_m", "gp_payoff_collude_coverup_m", "gp_defect_dominance_wedge_m"],
      "properties": {
        "vc_gp_5yr_fee_annuity_m": {"type": "number"},
        "gp_payoff_defect_scapegoat_m": {"type": "number"},
        "gp_payoff_collude_coverup_m": {"type": "number"},
        "gp_defect_dominance_wedge_m": {"type": "number"},
        "defect_strictly_dominates": {"type": "boolean", "const": true}
      }
    },
    "catalyst_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "event"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "event": {"type": "string"},
          "instrument": {"type": "string"}
        }
      }
    }
  }
}
