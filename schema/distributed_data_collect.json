{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DistributedDataCollectPayload",
  "type": "object",
  "properties": {
    "payload_id": {
      "type": "string",
      "pattern": "^data-[a-f0-9]{16}$"
    },
    "collection_type": {
      "type": "string",
      "enum": ["WEB_SCRAPE", "PUBLIC_ARCHIVE", "ENVIRONMENTAL_TELEMETRY", "POOLED_COMMERCIAL_FEED"]
    },
    "target_identifier": {
      "type": "string",
      "description": "URI, public record key, sensor metric name, or commercial feed identifier"
    },
    "timestamp_utc": {
      "type": "integer",
      "minimum": 0
    },
    "statutory_compliance": {
      "type": "object",
      "properties": {
        "public_unauthenticated_boundary_verified": {
          "type": "boolean",
          "description": "True if payload was collected strictly from unauthenticated public endpoints without login or access control bypass (CFAA § 1030 compliance)"
        },
        "zero_auth_bypass_verified": {
          "type": "boolean",
          "description": "True if no CAPTCHA, session token, paywall, or authentication wall was bypassed"
        },
        "rate_limit_governor_active": {
          "type": "boolean",
          "description": "True if anti-DoS rate limiting throttling was enforced during extraction"
        },
        "statutory_compliance_attested": {
          "type": "boolean",
          "description": "True if collection adheres strictly to domestic and international cybercrime statutes"
        }
      },
      "required": [
        "public_unauthenticated_boundary_verified",
        "zero_auth_bypass_verified",
        "rate_limit_governor_active",
        "statutory_compliance_attested"
      ],
      "additionalProperties": false
    },
    "extracted_ast": {
      "type": "object",
      "description": "Structured JSON parsed locally from HTML, public document, or non-infringing commercial feed derivative"
    },
    "fuzzed_telemetry": {
      "type": "object",
      "properties": {
        "metric_name": { "type": "string" },
        "raw_quantized_value": { "type": "number" },
        "noise_delta": { "type": "number" },
        "fuzzed_value": { "type": "number" }
      },
      "required": ["metric_name", "raw_quantized_value", "noise_delta", "fuzzed_value"],
      "additionalProperties": false
    },
    "pooled_escrow": {
      "type": "object",
      "properties": {
        "escrow_id": { "type": "string" },
        "contributing_nodes_count": { "type": "integer", "minimum": 1 },
        "total_micro_settlement_sats": { "type": "integer", "minimum": 1 },
        "non_infringing_derivative_attested": { "type": "boolean" }
      },
      "required": ["escrow_id", "contributing_nodes_count", "total_micro_settlement_sats", "non_infringing_derivative_attested"],
      "additionalProperties": false
    },
    "node_attestation": {
      "type": "object",
      "properties": {
        "node_id": { "type": "string" },
        "signature_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["node_id", "signature_hash"],
      "additionalProperties": false
    }
  },
  "required": [
    "payload_id",
    "collection_type",
    "target_identifier",
    "timestamp_utc",
    "statutory_compliance",
    "node_attestation"
  ],
  "additionalProperties": false
}
