    "sovereign_outlier_screen": {
      "type": "object",
      "description": "EQ_01: 2D->1D phrenological dimensional collapse.",
      "additionalProperties": false,
      "properties": {
        "theta_g": { "const": 0.8 },
        "theta_e": { "const": 0.5 },
        "s_crit_threshold": { "const": 0.8 },
        "observed_g": { "type": "number", "minimum": 0.99, "maximum": 1.0 },
        "observed_e": { "type": "number", "minimum": 0.99, "maximum": 1.0 },
        "true_clinical_dysfunction_d": { "const": 0.0 },
        "surface_checklist_score_s_c": { "const": 0.99 },
        "p_false_positive_given_sovereign_outlier": { "const": 1.0 }
      },
      "required": [
        "theta_g",
        "theta_e",
        "s_crit_threshold",
        "observed_g",
        "observed_e",
        "true_clinical_dysfunction_d",
        "surface_checklist_score_s_c",
        "p_false_positive_given_sovereign_outlier"
      ]
    },
    "diagnostic_reliability": {
      "type": "object",
      "description": "EQ_02: inter-rater kappa reliability below the Daubert floor.",
      "additionalProperties": false,
      "properties": {
        "kappa_gad": { "const": 0.2 },
        "kappa_aspd": { "const": 0.21 },
        "kappa_mixed": { "const": 0.24 },
        "kappa_mdd": { "const": 0.28 },
        "kappa_schizoaffective": { "const": 0.46 },
        "inter_rater_disagreement_min": { "const": 0.54 },
        "inter_rater_disagreement_max": { "const": 0.8 }
      },
      "required": [
        "kappa_gad",
        "kappa_aspd",
        "kappa_mixed",
        "kappa_mdd",
        "kappa_schizoaffective",
        "inter_rater_disagreement_min",
        "inter_rater_disagreement_max"
