    "bayesian_ppv_collapse": {
      "type": "object",
      "description": "EQ_02: PPV collapse below the FRE 702 preponderance threshold.",
      "additionalProperties": false,
      "properties": {
        "prevalence_pi": { "const": 0.08 },
        "sensitivity_se": { "const": 0.6 },
        "specificity_sp": { "const": 0.85 },
        "ppv_exact": { "const": 0.25806451612903225 },
        "ppv_pct_rounded": { "const": 25.81 },
        "fre_702_preponderance_threshold": { "const": 0.5 },
        "fre_702_preponderance_satisfied": { "const": false }
      },
      "required": [
        "prevalence_pi",
        "sensitivity_se",
        "specificity_sp",
        "ppv_exact",
        "ppv_pct_rounded",
        "fre_702_preponderance_threshold",
        "fre_702_preponderance_satisfied"
      ]
