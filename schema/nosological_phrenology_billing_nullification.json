    "neural_crest_validation": {
      "type": "object",
      "description": "EQ_03: Bayes-inversion phrenology exaggeration factor.",
      "additionalProperties": false,
      "properties": {
        "neural_crest_correlation_r": { "const": 0.15 },
        "variance_explained_r2": { "const": 0.0225 },
        "unpredicted_sovereign_variance_u": { "const": 0.9775 },
        "phrenology_exaggeration_factor_lambda": { "const": 44.44444444444444 }
      },
      "required": [
        "neural_crest_correlation_r",
        "variance_explained_r2",
        "unpredicted_sovereign_variance_u",
        "phrenology_exaggeration_factor_lambda"
      ]
    },
    "information_theoretic_falsifiability": {
      "type": "object",
      "description": "EQ_04: anosognosia / Criterion-B non-falsifiability identity.",
      "additionalProperties": false,
      "properties": {
        "p_confirm_given_observation": { "const": 1.0 },
        "shannon_mutual_information_bits": { "const": 0.0 },
        "falsifiable": { "const": false }
      },
      "required": [
        "p_confirm_given_observation",
        "shannon_mutual_information_bits",
        "falsifiable"
