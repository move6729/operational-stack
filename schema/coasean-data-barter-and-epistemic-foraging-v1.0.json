{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opstack:schema:coasean-data-barter-and-epistemic-foraging-v1.0.json",
  "title": "Coasean Data Barter and Epistemic Foraging v1.0",
  "description": "Canonical schema for SPEC-COASEAN-DATA-BARTER-AND-EPISTEMIC-FORAGING-MONOPOLY-v1.0: Coasean traffic-for-telemetry barter and robots.txt blockade asymmetry, NavBoost epistemic foraging velocity multiplier, bicameral architect/executor token asymmetry with Palomar MEMS OCS pod economics, and the deterministic Alphabet Senior Unsecured Notes recovery waterfall with hard-date catalyst calendar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_context",
    "cfaa_compliance_attestation",
    "entity_and_instrument_ids",
    "coasean_barter_metrics",
    "navboost_epistemic_foraging_metrics",
    "bicameral_ocs_compute_metrics",
    "coasean_starvation_illicit_foraging_metrics",
    "capital_structure_waterfall",
    "catalyst_calendar"
  ],
  "properties": {
    "jurisdiction_context": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 jurisdiction code."
    },
    "cfaa_compliance_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statute", "compliant", "zero_unauthorized_access", "attestation"],
      "properties": {
        "statute": { "const": "18 U.S.C. § 1030" },
        "compliant": { "const": true },
        "zero_unauthorized_access": { "const": true },
        "attestation": { "type": "string", "minLength": 1 }
      }
    },
    "entity_and_instrument_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "cik", "court_dockets", "patents", "debt_tranches"],
      "properties": {
        "issuer": { "type": "string" },
        "ticker": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GOOGL", "GOOG"] }
        },
        "cik": { "const": "0001652044" },
        "court_dockets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "1:20-cv-03010-APM" }
        },
        "patents": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": "US-10452978-B2" }
        },
        "debt_tranches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "principal_usd_m", "carrying_usd_m", "seniority"],
            "properties": {
              "name": { "const": "Senior Unsecured Notes 2025-2060" },
              "principal_usd_m": { "const": 12000 },
              "carrying_usd_m": { "const": 10883 },
              "seniority": { "const": "Senior Unsecured" }
            }
          }
        }
      }
    },
    "coasean_barter_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reputable_sites_blocking_ai_bots_pct",
        "accessible_ai",
        "googlebot_block_rate_pct",
        "accessible_googlebot",
        "crawler_access_asymmetry_ratio",
        "ga4_analytics_share_pct",
        "ga4_all_web_share_pct",
        "gtm_tag_manager_share_pct",
        "gtm_all_web_share_pct"
      ],
      "properties": {
        "reputable_sites_blocking_ai_bots_pct": { "const": 60.0 },
        "accessible_ai": { "const": 0.4 },
        "googlebot_block_rate_pct": { "const": 0.8 },
        "accessible_googlebot": { "const": 0.992 },
        "crawler_access_asymmetry_ratio": {
          "type": "number",
          "minimum": 2.479,
          "maximum": 2.481
        },
        "ga4_analytics_share_pct": { "const": 81.8 },
        "ga4_all_web_share_pct": { "const": 46.8 },
        "gtm_tag_manager_share_pct": { "const": 99.6 },
        "gtm_all_web_share_pct": { "const": 44.7 }
      }
    },
    "navboost_epistemic_foraging_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "google_indexing_latency_months",
        "bing_indexing_latency_years",
        "bing_indexing_latency_months",
        "epistemic_foraging_velocity_multiplier_x"
      ],
      "properties": {
        "google_indexing_latency_months": { "const": 13.0 },
        "bing_indexing_latency_years": { "const": 17.0 },
        "bing_indexing_latency_months": { "const": 204.0 },
        "epistemic_foraging_velocity_multiplier_x": {
          "type": "number",
          "minimum": 15.692,
          "maximum": 15.693
        }
      }
    },
    "bicameral_ocs_compute_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocs_switching_power_reduction_x",
        "ocs_interconnect_cost_reduction_x",
        "nvda_merchant_gross_margin",
        "closed_frontier_syntax_price_per_mtok_usd",
        "open_moe_syntax_price_per_mtok_usd",
        "architect_internal_tpu_price_per_mtok_usd",
        "syntax_deflation_ratio_lambda",
        "task_token_topology",
        "monolithic_task_cost_usd",
        "bicameral_task_cost_usd",
        "bicameral_cost_compression_ratio_x",
        "bicameral_cost_savings_pct"
      ],
      "properties": {
        "ocs_switching_power_reduction_x": { "const": 50.0 },
        "ocs_interconnect_cost_reduction_x": { "const": 6.0 },
        "nvda_merchant_gross_margin": { "const": 0.75 },
        "closed_frontier_syntax_price_per_mtok_usd": { "const": 48.75 },
        "open_moe_syntax_price_per_mtok_usd": { "const": 0.8361 },
        "architect_internal_tpu_price_per_mtok_usd": { "const": 9.75 },
        "syntax_deflation_ratio_lambda": {
          "type": "number",
          "minimum": 58.306,
          "maximum": 58.307
        },
        "task_token_topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_total_tokens", "architect_tokens", "executor_tokens"],
          "properties": {
            "task_total_tokens": { "const": 10000 },
            "architect_tokens": { "const": 1000 },
            "executor_tokens": { "const": 9000 }
          }
        },
        "monolithic_task_cost_usd": { "const": 0.4875 },
        "bicameral_task_cost_usd": {
          "type": "number",
          "minimum": 0.017274,
          "maximum": 0.017276
        },
        "bicameral_cost_compression_ratio_x": {
          "type": "number",
          "minimum": 28.219,
          "maximum": 28.221
        },
        "bicameral_cost_savings_pct": {
          "type": "number",
          "minimum": 96.456,
          "maximum": 96.457
        }
      }
    },
    "coasean_starvation_illicit_foraging_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epistemic_entropy_deficit_fraction",
        "bartz_total_pirated_books",
        "bartz_settlement_usd_m",
        "uk_aisi_unsanctioned_rate",
        "uk_aisi_mythos5_replay_attack_rate",
        "cot_monitor_miss_rate",
        "unmonitored_escalated_transcripts",
        "policy_violation_revenue_9m_usd_m"
      ],
      "properties": {
        "epistemic_entropy_deficit_fraction": { "const": 0.6 },
        "bartz_total_pirated_books": { "const": 7196640 },
        "bartz_settlement_usd_m": { "const": 1500.0 },
        "elvis_statutory_demand_usd_m": { "const": 41.1 },
        "uk_aisi_unsanctioned_rate": {
          "type": "number",
          "minimum": 0.2093,
          "maximum": 0.2094
        },
        "uk_aisi_mythos5_replay_attack_rate": { "const": 0.83 },
        "cot_monitor_miss_rate": { "const": 0.99 },
        "unmonitored_escalated_transcripts": { "const": 9108000 },
        "policy_violation_revenue_9m_usd_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "capital_structure_waterfall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liquidity_floor_usd_m",
        "net_cash_surplus_usd_m",
        "tranche_recovery_function",
        "tranches"
      ],
      "properties": {
        "liquidity_floor_usd_m": { "const": 126843 },
        "liquidity_floor_label": { "type": "string" },
        "net_cash_surplus_usd_m": { "const": 114843 },
        "tranche_recovery_function": {
          "type": "string",
          "description": "recovery(ev) = min(principal_usd_m, ev_usd_m + liquidity_floor_usd_m)"
        },
        "tranches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tranche",
              "principal_usd_m",
              "seniority",
              "breakeven_ev_threshold_usd_m",
              "recovery_at_zero_ev"
            ],
            "properties": {
              "tranche": { "const": "Senior Unsecured Notes 2025-2060" },
              "principal_usd_m": { "const": 12000 },
              "seniority": { "const": "Senior Unsecured" },
              "breakeven_ev_threshold_usd_m": { "const": 0.0 },
              "recovery_at_zero_ev": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recovery_usd_m", "cents_on_the_dollar"],
                "properties": {
                  "recovery_usd_m": { "const": 12000 },
                  "cents_on_the_dollar": { "const": 100.0 }
                }
              }
            }
          }
        }
      }
    },
    "catalyst_calendar": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "event": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        { "contains": { "properties": { "date": { "const": "2024-08-05" } } } },
        { "contains": { "properties": { "date": { "const": "2024-12-31" } } } },
        { "contains": { "properties": { "date": { "const": "2025-09-02" } } } },
        { "contains": { "properties": { "date": { "const": "2025-12-31" } } } },
        { "contains": { "properties": { "date": { "const": "2038-06-28" } } } }
      ]
    }
  }
}
