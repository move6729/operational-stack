{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opstack:schema:tpu_spv_foreclosure_and_mvno_arbitrage.json",
  "title": "TPU Generation 8 Compute SPV Step-In Foreclosure, Neocloud SRMC Dumping Cage & Wholesale MVNO Arbitrage Schema",
  "description": "JSON Schema Draft 2020-12 validating Alphabet $153.1B off-balance-sheet compute commitments, $35.0B Compute SPV debt waterfall, TeraWulf Form 8-K 6-year 50% equipment step-in foreclosure option, Coasean TPU vs. GPU SRMC economics, and wholesale TPU MVNO routing.",
  "type": "object",
  "required": [
    "jurisdiction_context",
    "cfaa_18_usc_1030_compliance_attestation",
    "entity_and_instrument_ids",
    "tpu_gen8_hardware_matrix",
    "spv_debt_stack_and_recovery",
    "terawulf_step_in_foreclosure_option",
    "catalyst_calendar",
    "neocloud_srmc_vs_mvno_arbitrage"
  ],
  "additionalProperties": false,
  "properties": {
    "jurisdiction_context": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "default": "US",
      "description": "ISO 3166-1 alpha-2 jurisdiction context code."
    },
    "cfaa_18_usc_1030_compliance_attestation": {
      "type": "boolean",
      "const": true,
      "description": "Immutable attestation of compliance with 18 U.S.C. 1030 and public-record provenance."
    },
    "entity_and_instrument_ids": {
      "type": "object",
      "required": [
        "ring_1_primary_sponsors_and_tenants",
        "ring_2_public_bdc_co_lenders",
        "ring_3_insurance_and_bermuda_sidecars",
        "ring_4_auditors_and_valuation_agents",
        "ring_5_public_pension_lps_and_consultants",
        "ring_6_trustees_admin_agents_and_counsel"
      ],
      "additionalProperties": false,
      "properties": {
        "ring_1_primary_sponsors_and_tenants": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": ["legal_name", "ticker_or_status", "cik", "role"],
            "additionalProperties": false,
            "properties": {
              "legal_name": { "type": "string" },
              "ticker_or_status": { "type": "string" },
              "cik": { "type": "string", "pattern": "^[0-9]{10}$" },
              "role": { "type": "string" }
            }
          }
        },
        "ring_2_public_bdc_co_lenders": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["legal_name", "ticker", "cik"],
            "additionalProperties": false,
            "properties": {
              "legal_name": { "type": "string" },
              "ticker": { "type": "string" },
              "cik": { "type": "string", "pattern": "^[0-9]{10}$" }
            }
          }
        },
        "ring_3_insurance_and_bermuda_sidecars": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["legal_name", "identifier_type", "identifier_value"],
            "additionalProperties": false,
            "properties": {
              "legal_name": { "type": "string" },
              "identifier_type": { "type": "string", "enum": ["CIK", "NAIC"] },
              "identifier_value": { "type": "string" }
            }
          }
        },
        "ring_4_auditors_and_valuation_agents": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        },
        "ring_5_public_pension_lps_and_consultants": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" }
        },
        "ring_6_trustees_admin_agents_and_counsel": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "tpu_gen8_hardware_matrix": {
      "type": "object",
      "required": [
        "topology_architecture",
        "torus_3d_max_hops",
        "boardfly_max_hops",
        "hop_reduction_pct",
        "ironwood_hbm_gb",
        "ironwood_bandwidth_tbps",
        "tpu_8i_max_hbm_gb",
        "tpu_8i_max_bandwidth_tbps",
        "bandwidth_multiplier_vs_ironwood",
        "torchtitan_8192_chip_mfu_pct",
        "citadel_cost_reduction_pct",
        "citadel_speedup_multiple"
      ],
      "additionalProperties": false,
      "properties": {
        "topology_architecture": { "type": "string", "const": "Boardfly Optical-Electrical Fabric" },
        "torus_3d_max_hops": { "type": "integer", "const": 16 },
        "boardfly_max_hops": { "type": "integer", "const": 7 },
        "hop_reduction_pct": { "type": "number", "const": 56.25 },
        "ironwood_hbm_gb": { "type": "integer", "const": 192 },
        "ironwood_bandwidth_tbps": { "type": "number", "const": 7.38 },
        "tpu_8i_max_hbm_gb": { "type": "integer", "const": 384 },
        "tpu_8i_max_bandwidth_tbps": { "type": "number", "const": 17.2 },
        "bandwidth_multiplier_vs_ironwood": { "type": "number", "minimum": 2.33, "maximum": 2.34 },
        "torchtitan_8192_chip_mfu_pct": { "type": "number", "const": 52.0 },
        "citadel_cost_reduction_pct": { "type": "number", "const": 30.0 },
        "citadel_speedup_multiple": { "type": "number", "const": 4.0 }
      }
    },
    "spv_debt_stack_and_recovery": {
      "type": "object",
      "required": [
        "alphabet_active_guarantees_billions",
        "alphabet_pending_guarantees_billions",
        "alphabet_uncommenced_leases_billions",
        "alphabet_total_obs_commitments_billions",
        "spv_total_capitalization_billions",
        "tpu_blended_debt_yield_pct",
        "nvidia_neocloud_debt_yield_pct",
        "spread_advantage_bps",
        "annual_interest_savings_millions",
        "six_year_interest_savings_billions",
        "tranches",
        "stress_ev_recovery_waterfall"
      ],
      "additionalProperties": false,
      "properties": {
        "alphabet_active_guarantees_billions": { "type": "number", "const": 43.8 },
        "alphabet_pending_guarantees_billions": { "type": "number", "const": 24.1 },
        "alphabet_uncommenced_leases_billions": { "type": "number", "const": 85.2 },
        "alphabet_total_obs_commitments_billions": { "type": "number", "const": 153.1 },
        "spv_total_capitalization_billions": { "type": "number", "const": 35.0 },
        "tpu_blended_debt_yield_pct": { "type": "number", "const": 7.1 },
        "nvidia_neocloud_debt_yield_pct": { "type": "number", "const": 9.3 },
        "spread_advantage_bps": { "type": "integer", "const": 220 },
        "annual_interest_savings_millions": { "type": "number", "const": 770.0 },
        "six_year_interest_savings_billions": { "type": "number", "const": 4.62 },
        "tranches": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["tranche_name", "principal_billions", "coupon_pct", "seniority_rank", "collateral_box"],
            "additionalProperties": false,
            "properties": {
              "tranche_name": { "type": "string" },
              "principal_billions": { "type": "number" },
              "coupon_pct": { "type": "number" },
              "seniority_rank": { "type": "integer", "minimum": 1, "maximum": 3 },
              "collateral_box": { "type": "string" }
            }
          }
        },
        "stress_ev_recovery_waterfall": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["ev_billions", "tranche_a_cents", "tranche_b_cents", "tranche_c_cents"],
            "additionalProperties": false,
            "properties": {
              "ev_billions": { "type": "number" },
              "tranche_a_cents": { "type": "number", "minimum": 0, "maximum": 100 },
              "tranche_b_cents": { "type": "number", "minimum": 0, "maximum": 100 },
              "tranche_c_cents": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "terawulf_step_in_foreclosure_option": {
      "type": "object",
      "required": [
        "facility_entity",
        "critical_it_load_mw",
        "lease_term_years",
        "contracted_lease_value_billions",
        "equipment_capacity_trigger_share",
        "equipment_capacity_trigger_mw",
        "trigger_window_years",
        "automatic_novation_cure_days"
      ],
      "additionalProperties": false,
      "properties": {
        "facility_entity": { "type": "string", "const": "Raylan Data LLC (Hawesville, KY)" },
        "critical_it_load_mw": { "type": "number", "const": 401.0 },
        "lease_term_years": { "type": "integer", "const": 20 },
        "contracted_lease_value_billions": { "type": "number", "const": 19.0 },
        "equipment_capacity_trigger_share": { "type": "number", "const": 0.5 },
        "equipment_capacity_trigger_mw": { "type": "number", "const": 200.5 },
        "trigger_window_years": { "type": "integer", "const": 6 },
        "automatic_novation_cure_days": { "type": "integer", "const": 30 }
      }
    },
    "catalyst_calendar": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["iso_date", "event_type", "counterparty", "material_threshold"],
        "additionalProperties": false,
        "properties": {
          "iso_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "event_type": { "type": "string" },
          "counterparty": { "type": "string" },
          "material_threshold": { "type": "string" }
        }
      }
    },
    "neocloud_srmc_vs_mvno_arbitrage": {
      "type": "object",
      "required": [
        "tpu_amortized_atc_per_hr",
        "gpu_neocloud_amortized_atc_per_hr",
        "coasean_atc_cost_advantage_multiple",
        "gpu_srmc_watts_per_hr",
        "distressed_clearing_price_per_hr",
        "chapter_11_hourly_cash_contribution",
        "chapter_11_hourly_gaap_net_loss",
        "retail_gcp_blended_per_m_tokens",
        "wholesale_mvno_blended_per_m_tokens",
        "mvno_cost_reduction_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "tpu_amortized_atc_per_hr": { "type": "number", "const": 0.68 },
        "gpu_neocloud_amortized_atc_per_hr": { "type": "number", "const": 2.18 },
        "coasean_atc_cost_advantage_multiple": { "type": "number", "minimum": 3.2, "maximum": 3.22 },
        "gpu_srmc_watts_per_hr": { "type": "number", "const": 0.18 },
        "distressed_clearing_price_per_hr": { "type": "number", "const": 0.65 },
        "chapter_11_hourly_cash_contribution": { "type": "number", "const": 0.47 },
        "chapter_11_hourly_gaap_net_loss": { "type": "number", "const": -1.53 },
        "retail_gcp_blended_per_m_tokens": { "type": "number", "const": 1.65 },
        "wholesale_mvno_blended_per_m_tokens": { "type": "number", "const": 0.22 },
        "mvno_cost_reduction_pct": { "type": "number", "minimum": 86.6, "maximum": 86.7 }
      }
    }
  }
}
