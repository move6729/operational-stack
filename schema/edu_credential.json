{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenEduCredential",
  "description": "Schema for Sovereign Educational Credential & Academic Graph (OPEN-EDU-v1.0)",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "OPEN-EDU-v1.0"
    },
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "student_did": {
      "type": "string"
    },
    "institution_did": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "mastery_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "local_state_vector": {
      "type": "object",
      "properties": {
        "state_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "timestamp_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["state_hash", "timestamp_epoch"]
    },
    "security_invariants": {
      "type": "object",
      "properties": {
        "isolated_sandbox_required": {
          "type": "boolean",
          "const": true
        },
        "statutory_compliance_verified": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["isolated_sandbox_required", "statutory_compliance_verified"]
    }
  },
  "required": [
    "protocol_version",
    "credential_id",
    "student_did",
    "institution_did",
    "course_code",
    "mastery_score",
    "local_state_vector",
    "security_invariants"
  ]
}
