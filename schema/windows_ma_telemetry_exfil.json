{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opstack:schema:windows_ma_telemetry_exfil.json",
  "title": "Windows MA System Injection and Dynamic Exfiltration Routing Corpus Bundle",
  "description": "Schema for the Windows managed-assistance system-injection and dynamic exfiltration-routing bundle: disassembled binary constants, governing equations, 5-tranche $940.50M waterfall, 15 EFTA Bates records, 6-Ring registrants, catalyst calendar, and two-layer epistemic firewall hypotheses.",
  "type": "object",
  "required": [
    "spec",
    "two_layer_epistemic_firewall",
    "records",
    "registrants",
    "binaries",
    "governing_equations",
    "waterfall",
    "catalyst_calendar",
    "hypotheses",
    "tel_aviv_ildc_dual_compulsion_matrix"
  ],
  "additionalProperties": false,
  "properties": {
    "tel_aviv_ildc_dual_compulsion_matrix": {
      "type": "object",
      "required": [
        "engineering_hub",
        "penal_law_gag_min_years",
        "penal_law_gag_max_years",
        "p_comply_foreign_gag",
        "effective_us_oversight_custody",
        "ildc_ma_spinouts_count",
        "ildc_ma_spinouts",
        "israeli_compulsion_statutes",
        "us_statutory_exposure_checklist"
      ],
      "properties": {
        "engineering_hub": { "type": "string", "const": "Microsoft Israel R&D Center (ILDC, Herzliya / Tel Aviv)" },
        "penal_law_gag_min_years": { "type": "integer", "const": 7 },
        "penal_law_gag_max_years": { "type": "integer", "const": 15 },
        "p_comply_foreign_gag": { "type": "number", "const": 1.0 },
        "effective_us_oversight_custody": { "type": "number", "const": 0.0 },
        "ildc_ma_spinouts_count": { "type": "integer", "const": 5 },
        "ildc_ma_spinouts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "enum": ["Aorato", "Adallom", "Secure Islands", "Hexadite", "CyberX"] }
        },
        "israeli_compulsion_statutes": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" }
        },
        "us_statutory_exposure_checklist": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "5 U.S.C. § 3331",
              "18 U.S.C. § 793(d)-(f)",
              "18 U.S.C. § 1030(a)(1)",
              "18 U.S.C. § 371",
              "18 U.S.C. § 1001",
              "18 U.S.C. § 1519",
              "32 C.F.R. Part 117"
            ]
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["canonical_specification", "title", "version", "license"],
      "properties": {
        "canonical_specification": {
          "type": "string",
          "pattern": "^SPEC-WINDOWS-MA-SYSTEM-INJECTION-AND-DYNAMIC-EXFIL-ROUTING-v1\\.0$"
        },
        "title": { "type": "string" },
        "version": { "type": "string", "const": "v1.0" },
        "license": { "type": "string", "const": "Unlicense" }
      }
    },
    "two_layer_epistemic_firewall": {
      "type": "object",
      "required": ["h0_baseline", "h1_mechanism", "records_layer", "synthesis_layer"],
      "properties": {
        "h0_baseline": { "type": "string" },
        "h1_mechanism": { "type": "string" },
        "records_layer": { "type": "array", "items": { "type": "string" } },
        "synthesis_layer": { "type": "array", "items": { "type": "string" } }
      }
    },
    "records": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/bates_record" }
    },
    "registrants": {
      "type": "object",
      "required": [
        "ring1_primary_target",
        "ring2_credit_counterparties",
        "ring3_insurance_counterparties",
        "ring4_auditors",
        "ring5_institutional_lp_vehicles",
        "ring6_counsel_and_regulators"
      ],
      "properties": {
        "ring1_primary_target": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/registrant" } },
        "ring2_credit_counterparties": { "type": "array", "items": { "$ref": "#/$defs/registrant" } },
        "ring3_insurance_counterparties": { "type": "array", "items": { "$ref": "#/$defs/registrant" } },
        "ring4_auditors": { "type": "array", "items": { "$ref": "#/$defs/registrant" } },
        "ring5_institutional_lp_vehicles": { "type": "array", "items": { "$ref": "#/$defs/registrant" } },
        "ring6_counsel_and_regulators": { "type": "array", "items": { "$ref": "#/$defs/registrant" } }
      }
    },
    "binaries": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/binary" }
    },
    "governing_equations": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/governing_equation" }
    },
    "waterfall": {
      "type": "object",
      "required": ["currency", "total_principal_usd_m", "tranches"],
      "properties": {
        "currency": { "type": "string", "const": "USD" },
        "total_principal_usd_m": { "type": "string", "const": "940.50" },
        "tranches": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/tranche" }
        }
      }
    },
    "catalyst_calendar": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/catalyst" }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/hypothesis" }
    }
  },
  "$defs": {
    "bates_record": {
      "type": "object",
      "required": ["bates", "date", "role"],
      "properties": {
        "bates": { "type": "string", "pattern": "^(EFTA\\d+\\.xlsx|vol\\d+-efta\\d+-pdf|EFTA\\d+)$" },
        "date": { "type": "string", "format": "date" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "registrant": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "cik": { "type": ["string", "null"], "pattern": "^\\d{10}$" },
        "crd": { "type": ["string", "null"] },
        "naic": { "type": ["string", "null"] },
        "pcaob_firm_id": { "type": ["string", "null"] },
        "docket": { "type": ["string", "null"] },
        "ticker": { "type": ["string", "null"] }
      }
    },
    "binary": {
      "type": "object",
      "required": ["name", "pdb_guid"],
      "properties": {
        "name": { "type": "string", "enum": ["diagtrack.dll", "SenseIR.exe", "SenseCncProxy.exe", "MsSense.exe", "MpClient.dll", "cdp.dll", "fveapi.dll"] },
        "pdb_guid": { "type": "string", "pattern": "^[0-9A-F]{32}$" },
        "image_base": { "type": "integer" },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rva_start", "rva_end"],
            "properties": {
              "name": { "type": "string" },
              "rva_start": { "type": "integer", "minimum": 1 },
              "rva_end": { "type": "integer" },
              "instruction_count": { "type": "integer" }
            }
          }
        }
      }
    },
    "governing_equation": {
      "type": "object",
      "required": ["id", "statement", "closed_form"],
      "properties": {
        "id": { "type": "string", "enum": ["GE1_SHANNON_FLUSH", "GE2_EXPORT_CONCEALMENT_OMEGA", "GE3_MARKOV_PI_ACTIVE", "GE4_DETECTION_COLLAPSE"] },
        "statement": { "type": "string" },
        "closed_form": { "type": "string" }
      }
    },
    "tranche": {
      "type": "object",
      "required": ["name", "principal_usd_m"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "T1_TVPA_CLASS_SETTLEMENTS",
            "T2_SOVEREIGN_REGULATORY_ENFORCEMENT",
            "T3_INSTITUTIONAL_PRINCIPAL_USVI_SETTLEMENTS",
            "T4_SOUTHERN_TRUST_UNCLAWED_RETAINED_FEE_POOL",
            "T5_DOWNSTREAM_VENTURE_LP_ALLOCATION"
          ]
        },
        "principal_usd_m": { "type": "string", "enum": ["365.00", "255.00", "137.50", "143.00", "40.00"] }
      }
    },
    "catalyst": {
      "type": "object",
      "required": ["date", "event"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "event": { "type": "string" }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^H[01]_" },
        "statement": { "type": "string" },
        "status": { "type": "string", "enum": ["baseline", "mechanism", "falsified", "supported"] }
      }
    }
  }
}
