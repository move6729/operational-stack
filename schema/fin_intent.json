{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFinIntent",
  "description": "Schema for Open Financial Intent & Settlement Protocol (OPEN-FIN-v1.0)",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "OPEN-FIN-v1.0"
    },
    "object_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_type": {
      "type": "string",
      "enum": ["payment_intent", "settlement_batch", "liquidity_pool", "escrow_lock", "account_attestation"]
    },
    "jurisdiction_context": {
      "type": "object",
      "properties": {
        "jurisdiction_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "cross_border_vat_tax_flag": {
          "type": "boolean"
        },
        "cfaa_compliance_attested": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["jurisdiction_code", "cross_border_vat_tax_flag", "cfaa_compliance_attested"],
      "additionalProperties": false
    },
    "local_state_vector": {
      "type": "object",
      "properties": {
        "state_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "timestamp_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["state_hash", "timestamp_epoch"]
    },
    "relations_graph": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "security_invariants": {
      "type": "object",
      "properties": {
        "isolated_sandbox_required": {
          "type": "boolean",
          "const": true
        },
        "statutory_compliance_verified": {
          "type": "boolean",
          "const": true
        },
        "cfaa_compliance_attested": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["isolated_sandbox_required", "statutory_compliance_verified", "cfaa_compliance_attested"]
    }
  },
  "required": [
    "protocol_version",
    "object_id",
    "entity_type",
    "jurisdiction_context",
    "local_state_vector",
    "relations_graph",
    "security_invariants"
  ]
}
