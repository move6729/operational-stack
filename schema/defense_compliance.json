{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDefenseCompliance",
  "description": "Schema for Sovereign Defense Compliance, ITAR Verification, CMMC 2.0 Attestation, and AS9100 Material Traceability (OPEN-DEFENSE-COMPLIANCE-v1.0)",
  "type": "object",
  "properties": {
    "compliance_id": {
      "type": "string",
      "pattern": "^defcomp-[a-f0-9]{12}$"
    },
    "timestamp_utc": {
      "type": "integer",
      "minimum": 0
    },
    "node_id": {
      "type": "string"
    },
    "jurisdiction_context": {
      "type": "object",
      "properties": {
        "jurisdiction_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "cfaa_compliance_attested": {
          "type": "boolean",
          "const": true
        },
        "non_us_export_isolated": {
          "type": "boolean",
          "description": "True if non-US node is logically and physically partitioned from ITAR technical data."
        }
      },
      "required": ["jurisdiction_code", "cfaa_compliance_attested", "non_us_export_isolated"],
      "additionalProperties": false
    },
    "cage_code": {
      "type": "string",
      "pattern": "^[A-Z0-9]{5}$"
    },
    "itar_registration_number": {
      "type": "string",
      "pattern": "^M[0-9]{5}$"
    },
    "itar_expiration_timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "cmmc_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "sprs_score": {
      "type": "integer",
      "minimum": -203,
      "maximum": 110
    },
    "as9100_material_cert": {
      "type": "object",
      "properties": {
        "heat_number": {
          "type": "string"
        },
        "material_grade": {
          "type": "string"
        },
        "mill_test_report_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["heat_number", "material_grade", "mill_test_report_hash"]
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^def-[a-f0-9]{12}$"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "compliance_id",
    "timestamp_utc",
    "node_id",
    "jurisdiction_context",
    "cage_code",
    "itar_registration_number",
    "itar_expiration_timestamp",
    "cmmc_level",
    "sprs_score",
    "as9100_material_cert",
    "manifest_id",
    "state_hash"
  ]
}
