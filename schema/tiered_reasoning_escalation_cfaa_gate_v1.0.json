          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "tier_1_power_watts": {
          "type": "number",
          "minimum": 0.0
        },
        "tier_1_cost_per_task_usd": {
          "type": "number",
          "minimum": 0.0
        },
        "tier_2_cost_per_full_context_task_usd": {
          "type": "number",
          "minimum": 0.0
        },
        "tier_2_cost_per_dpp_ping_usd": {
          "type": "number",
          "minimum": 0.0
        },
        "blended_tre_initial_cost_per_task_usd": {
          "type": "number",
