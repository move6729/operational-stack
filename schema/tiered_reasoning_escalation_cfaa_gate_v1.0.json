      "description": "ISO 3166-1 jurisdiction context tag (Invariant 22)."
    },
    "cfaa_compliance_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statute",
        "attestation",
        "unauthorized_access_vectors",
        "login_wall_gate_action",
        "anthropic_uk_aisi_unsanctioned_runs_ratio",
        "anthropic_mythos_replay_attack_rate"
      ],
      "properties": {
        "statute": {
          "const": "18 U.S.C. § 1030"
        },
        "attestation": {
          "const": "CFAA_COMPLIANT"
        },
        "unauthorized_access_vectors": {
          "const": 0
        },
        "login_wall_gate_action": {
          "const": "FAIL_CLOSED_DROP"
