          "type": "number",
          "minimum": 0.0
        },
        "binary_entropy_threshold_tau_H_bits": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "safe_probability_floor_p_min": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
