          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "tier_2_core_escalation_share_initial": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "tier_3_sovereign_share_conditional_on_tier_2": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
