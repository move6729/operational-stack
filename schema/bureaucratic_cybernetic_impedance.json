        "cik": { "type": "string", "pattern": "^\\d{10}$" },
        "revenue_fy23_usd": { "type": "number", "minimum": 0.0 },
        "revenue_fy24_usd": { "type": "number", "minimum": 0.0 },
        "revenue_fy25_usd": { "type": "number", "minimum": 0.0 },
        "fy25_us_commercial_usd": { "type": "number", "minimum": 0.0 },
        "fy25_us_gov_usd": { "type": "number", "minimum": 0.0 },
        "fy25_total_us_usd": { "type": "number", "minimum": 0.0 },
        "q4_2025_total_usd": { "type": "number", "minimum": 0.0 },
        "q4_2025_us_commercial_usd": { "type": "number", "minimum": 0.0 },
        "q4_2025_us_commercial_yoy_growth_pct": { "type": "number" },
        "q4_2025_us_gov_usd": { "type": "number", "minimum": 0.0 },
