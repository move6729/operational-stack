        "rpo_fy24_usd": { "type": "number", "minimum": 0.0 },
        "rpo_fy25_usd": { "type": "number", "minimum": 0.0 },
        "rule_of_40_pct": { "type": "number" },
        "total_customers_fy23": { "type": "integer", "const": 497 },
        "total_customers_fy24": { "type": "integer", "const": 711 },
        "total_customers_fy25": { "type": "integer", "const": 954 },
        "top_20_avg_revenue_fy24_usd": { "type": "number", "const": 64600000.0 },
        "top_20_avg_revenue_fy25_usd": { "type": "number", "const": 93900000.0 },
        "fy26_revenue_usd": { "type": "number", "minimum": 0.0 },
        "rpo_usd": { "type": "number", "minimum": 0.0 }
      }
    },
    "tranche_recovery_row": {
      "type": "object",
      "required": ["tranche", "principal_usd", "recovery_usd", "cents_on_dollar"],
      "properties": {
        "tranche": { "enum": ["1L_BDC", "2L_Notes", "Unsecured_SI_FDE", "Sponsor_Equity"] },
        "principal_usd": { "type": "number", "minimum": 0.0 },
        "recovery_usd": { "type": "number", "minimum": 0.0 },
        "cents_on_dollar": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    }
  }
}