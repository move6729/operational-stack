    },
    "evolutionary_grounding_metrics": {
      "type": "object",
      "required": [
        "biological_deep_time_years",
        "biological_power_watts",
        "pure_silicon_ood_survival_prob",
        "symbiotic_bio_edge_ood_survival_prob"
      ],
      "properties": {
        "biological_deep_time_years": {
          "type": "number",
          "minimum": 3500000000.0
        },
        "biological_power_watts": {
          "type": "number",
          "maximum": 25.0
        },
        "pure_silicon_ood_survival_prob": {
          "type": "number",
          "maximum": 0.05
        },
        "symbiotic_bio_edge_ood_survival_prob": {
          "type": "number",
          "minimum": 0.95
        }
      }
    },
    "cranial_airgap_and_bci_pathology": {
      "type": "object",
      "required": [
        "elective_consumer_bci_tam_usd",
        "patient_1_thread_retraction_fraction",
        "battery_revision_cycle_years",
        "external_sensory_airgap_enforced",
        "remote_c2_neural_attack_surface"
      ],
      "properties": {
        "elective_consumer_bci_tam_usd": {
          "type": "number",
          "const": 0.0
        },
        "patient_1_thread_retraction_fraction": {
          "type": "number",
          "minimum": 0.8
        },
        "battery_revision_cycle_years": {
          "type": "number",
          "maximum": 7.0
        },
        "external_sensory_airgap_enforced": {
          "type": "boolean",
          "const": true
        },
        "remote_c2_neural_attack_surface": {
          "type": "number",
          "const": 0.0
        }
      }
    },
    "stochastic_bisociation_metrics": {
      "type": "object",
      "required": [
        "linear_rlhf_cross_domain_discovery_rate",
        "qrng_annealed_bio_edge_discovery_rate",
        "unfiltered_checksum_apophenia_collision_rate",
        "four_vector_gated_false_positive_rate"
