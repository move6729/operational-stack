      "properties": {
        "linear_rlhf_cross_domain_discovery_rate": {
          "type": "number",
          "maximum": 0.05
        },
        "qrng_annealed_bio_edge_discovery_rate": {
          "type": "number",
          "minimum": 0.8
        },
        "unfiltered_checksum_apophenia_collision_rate": {
          "type": "number",
          "minimum": 0.5
        },
        "four_vector_gated_false_positive_rate": {
          "type": "number",
