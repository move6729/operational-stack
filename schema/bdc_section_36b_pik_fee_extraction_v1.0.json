{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opstack:schema:bdc_section_36b_pik_fee_extraction_v1.0.json",
  "title": "BDC Section 36(b) PIK Fee Extraction and Cross-Held Software Tranche Waterfall",
  "description": "Typed measurement schema for the Investment Company Act of 1940 Section 36(b) fiduciary-duty fee-extraction mechanism at Blue Owl Capital Corp (OWL) and its two non-traded BDCs (OBDC, OTF). EQ-1 prices the cash-fee-on-paper-PIK drain at 0.9175 / 0.9200 of cash out per $1.00 of non-cash PIK income under a 90% Subchapter M distribution requirement. EQ-2 fixes the 4.24% critical PIK threshold against OTF's observed 25.0% share (5.8962x). EQ-3 cascades an 11.1% reported versus 20-30% true software share on $157.8B of credit AUM into $14.0442B-$29.8242B of hidden software, $2.80884B-$5.96484B of avoided 20% markdown, $42.1326M-$89.4726M of preserved 1.5% base fee, and $926.9172M-$1,968.3972M of OWL parent market cap at 22.0x FRE. EQ-4 re-bases a 17.5% / 20.0% incentive fee onto cash NII at 23.33% / 26.67% and caps the FY2025 disgorgement surface at the $690.4M combined OBDC + OTF fee stack. Also types the $291.263M combined cross-held Finastra / Pluralsight / CivicPlus tranche recovery waterfall and the zero-rent peer Schedule-of-Investments mosaic. All monetary values are USD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdiction_context", "cfaa_compliance_attestation", "itar_ear_public_domain_attestation", "entity_and_instrument_ids", "catalyst_calendar", "eq1_cash_fee_on_paper_pik", "eq2_critical_pik_threshold", "eq3_software_reclassification", "eq4_section_36b_effective_cash_fee_rate", "cross_held_tranche_stack", "tranche_recovery_waterfall", "peer_schedule_of_investments", "platform_and_parent_baseline"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "jurisdiction_context": { "$ref": "#/$defs/jurisdiction_context" },
    "cfaa_compliance_attestation": { "type": "boolean", "const": true, "description": "Zero unauthorized access under 18 U.S.C. 1030: every measured artifact is a public SEC EDGAR filing (Form 10-Q, Form 40-33, NPORT-P Schedule of Investments) or a public federal court docket, analyzed read-only." },
    "itar_ear_public_domain_attestation": { "type": "boolean", "const": true, "description": "Public-domain game-theoretic and accounting-identity systems specification; zero export-controlled technical data, hardware blueprints, or firmware (22 C.F.R. 120.34; 15 C.F.R. 734.7)." },
    "entity_and_instrument_ids": { "$ref": "#/$defs/entity_and_instrument_ids" },
    "catalyst_calendar": { "type": "array", "minItems": 10, "maxItems": 10, "description": "Hard-date catalyst and statutory-deadline calendar in strictly ascending ISO 8601 order.", "items": { "$ref": "#/$defs/catalyst_entry" } },
    "eq1_cash_fee_on_paper_pik": { "$ref": "#/$defs/eq1_cash_fee_on_paper_pik" },
    "eq2_critical_pik_threshold": { "$ref": "#/$defs/eq2_critical_pik_threshold" },
    "eq3_software_reclassification": { "$ref": "#/$defs/eq3_software_reclassification" },
    "eq4_section_36b_effective_cash_fee_rate": { "$ref": "#/$defs/eq4_section_36b_effective_cash_fee_rate" },
    "cross_held_tranche_stack": { "$ref": "#/$defs/cross_held_tranche_stack" },
    "tranche_recovery_waterfall": { "$ref": "#/$defs/tranche_recovery_waterfall" },
    "peer_schedule_of_investments": { "$ref": "#/$defs/peer_schedule_of_investments" },
    "platform_and_parent_baseline": { "$ref": "#/$defs/platform_and_parent_baseline" }
  },
  "$defs": {
    "jurisdiction_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iso_3166_1_alpha_2", "statutory_venue"],
      "properties": {
        "iso_3166_1_alpha_2": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 jurisdiction code." },
        "statutory_venue": { "type": "string", "minLength": 16, "description": "Investment Company Act of 1940 Section 36(b); SDNY 7:26-cv-03468-KPF and 1:26-cv-05183-KPF; SEC EDGAR Form 10-Q / Form 40-33; Subchapter M RIC 90%-distribution requirement." }
      }
    },
    "entity_and_instrument_ids": {
      "type": "object",
      "description": "Standardized security-master keys for every named principal, docket, accession, and debt tranche.",
      "additionalProperties": false,
      "required": ["ticker", "cik", "court_dockets", "form_40_33_accessions", "periodic_report_accessions", "named_debt_tranches"],
      "properties": {
        "ticker": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Z.]{1,6}$" }, "required": ["blue_owl_capital_corp", "blue_owl_capital_corp_ii", "blue_owl_technology_finance_corp"], "properties": { "blue_owl_capital_corp": { "const": "OWL" }, "blue_owl_capital_corp_ii": { "const": "OBDC" }, "blue_owl_technology_finance_corp": { "const": "OTF" }, "crescent_capital_bdc": { "const": "CGBD" } } },
        "cik": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]{10}$" }, "required": ["blue_owl_capital_corp", "blue_owl_capital_corp_ii", "blue_owl_technology_finance_corp", "star_mountain", "bow_river", "crescent_capital_bdc"], "properties": { "blue_owl_capital_corp": { "const": "0001823945" }, "blue_owl_capital_corp_ii": { "const": "0001655888" }, "blue_owl_technology_finance_corp": { "const": "0001747777" }, "star_mountain": { "const": "0001786835" }, "bow_river": { "const": "0001810256" }, "crescent_capital_bdc": { "const": "0001633336" } } },
        "court_dockets": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]:[0-9]{2}-cv-[0-9]{5}-[A-Z]{3}$" }, "required": ["blue_owl_capital_corp_ii", "blue_owl_technology_finance_corp"], "properties": { "blue_owl_capital_corp_ii": { "const": "7:26-cv-03468-KPF" }, "blue_owl_technology_finance_corp": { "const": "1:26-cv-05183-KPF" } } },
        "form_40_33_accessions": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$" }, "required": ["blue_owl_capital_corp_ii", "blue_owl_technology_finance_corp"], "properties": { "blue_owl_capital_corp_ii": { "const": "0001193125-26-201635" }, "blue_owl_technology_finance_corp": { "const": "0001193125-26-285516" } } },
        "periodic_report_accessions": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$" }, "required": ["blue_owl_capital_corp", "blue_owl_capital_corp_ii", "blue_owl_technology_finance_corp"], "properties": { "blue_owl_capital_corp": { "const": "0001823945-26-000040" }, "blue_owl_capital_corp_ii": { "const": "0001655888-26-000056" }, "blue_owl_technology_finance_corp": { "const": "0001747777-26-000028" } } },
        "named_debt_tranches": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/named_debt_tranche" } }
      }
    },
    "named_debt_tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tranche", "borrower", "terms", "seniority", "par_m", "fair_value_m", "mark_pct"],
      "properties": {
        "tranche": { "type": "string", "minLength": 4 },
        "borrower": { "type": "string", "minLength": 4 },
        "terms": { "type": "string", "minLength": 4 },
        "seniority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "par_m": { "type": "number", "exclusiveMinimum": 0 },
        "fair_value_m": { "type": "number", "minimum": 0 },
        "mark_pct": { "type": "number", "minimum": 0, "maximum": 105 }
      }
    },
    "catalyst_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "event", "basis"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Exact ISO 8601 calendar date (YYYY-MM-DD)." },
        "event": { "type": "string", "minLength": 16 },
        "basis": { "type": "string", "enum": ["reporting_period_end", "statutory_deadline_10q_45d", "statutory_deadline_10q_45d_next_business_day", "statutory_deadline_10k_60d", "ric_90pct_distribution_measurement", "section_36b_lookback_window_close"] }
      }
    },
    "eq1_cash_fee_on_paper_pik": {
      "type": "object",
      "description": "EQ-1: drain(r) = r + 0.90 x (1 - r) = 0.90 + 0.10r of cash out per $1.00 of non-cash PIK income.",
      "additionalProperties": false,
      "required": ["pik_income_m", "pik_share_pct", "implied_nii_m", "cash_nii_m", "ric_distribution_requirement", "cash_drain_per_pik_dollar_17_5_pct", "cash_drain_per_pik_dollar_20_0_pct", "q1_2026_pik_cash_drain_17_5_m", "q1_2026_pik_cash_drain_20_0_m", "q1_2026_pik_incentive_fee_17_5_m", "q1_2026_pik_incentive_fee_20_0_m", "annualized_pik_cash_drain_17_5_m"],
      "properties": {
        "pik_income_m": { "type": "number", "const": 43.0 },
        "pik_share_pct": { "type": "number", "const": 25.0 },
        "implied_nii_m": { "type": "number", "const": 172.0 },
        "cash_nii_m": { "type": "number", "const": 129.0 },
        "ric_distribution_requirement": { "type": "number", "const": 0.9 },
        "cash_drain_per_pik_dollar_17_5_pct": { "type": "number", "const": 0.9175 },
        "cash_drain_per_pik_dollar_20_0_pct": { "type": "number", "const": 0.92 },
        "q1_2026_pik_cash_drain_17_5_m": { "type": "number", "const": 39.4525 },
        "q1_2026_pik_cash_drain_20_0_m": { "type": "number", "const": 39.56 },
        "q1_2026_pik_incentive_fee_17_5_m": { "type": "number", "const": 7.525 },
        "q1_2026_pik_incentive_fee_20_0_m": { "type": "number", "const": 8.6 },
        "annualized_pik_cash_drain_17_5_m": { "type": "number", "const": 157.81 }
      }
    },
    "eq2_critical_pik_threshold": {
      "type": "object",
      "description": "EQ-2: 25.0 / 4.24 = 5.8962x breach of the 90%-distribution cash-coverage critical PIK threshold.",
      "additionalProperties": false,
      "required": ["critical_threshold_pct", "observed_otf_pik_share_pct", "breach_multiple", "threshold_excess_pts", "zero_retained_cash_ceiling_pct", "cash_collected_share_at_threshold_pct", "threshold_pik_cash_drain_m", "threshold_retained_cash_m", "observed_pik_cash_drain_m", "observed_retained_cash_m"],
      "properties": {
        "critical_threshold_pct": { "type": "number", "const": 4.24 },
        "observed_otf_pik_share_pct": { "type": "number", "const": 25.0 },
        "breach_multiple": { "type": "number", "const": 5.8962 },
        "threshold_excess_pts": { "type": "number", "const": 20.76 },
        "zero_retained_cash_ceiling_pct": { "type": "number", "const": 8.25 },
        "cash_collected_share_at_threshold_pct": { "type": "number", "const": 95.76 },
        "threshold_pik_cash_drain_m": { "type": "number", "const": 6.691144 },
        "threshold_retained_cash_m": { "type": "number", "const": 6.8972 },
        "observed_pik_cash_drain_m": { "type": "number", "const": 39.4525 },
        "observed_retained_cash_m": { "type": "number", "const": -28.81, "description": "Negative retained cash at a 25.0% PIK share proves the cash-fee-on-paper-PIK regime." }
      }
    },
    "eq3_software_reclassification": {
      "type": "object",
      "description": "EQ-3: 11.1% reported versus 20-30% true software share on $157.8B of credit AUM, cascaded to OWL parent market cap at 22.0x FRE.",
      "additionalProperties": false,
      "required": ["credit_aum_bn", "reported_software_pct", "true_software_pct_range", "understatement_pts_range", "reported_software_bn", "hidden_software_bn_range", "avoided_markdown_20pct_bn_range", "preserved_base_fee_1_5pct_m_range", "preserved_owl_market_cap_22x_m_range", "preserved_owl_market_cap_range_m_range", "fre_multiple_range", "fre_margin_pct_range"],
      "properties": {
        "credit_aum_bn": { "type": "number", "const": 157.8 },
        "reported_software_pct": { "type": "number", "const": 11.1 },
        "true_software_pct_range": { "$ref": "#/$defs/ascending_pair" },
        "understatement_pts_range": { "$ref": "#/$defs/ascending_pair" },
        "reported_software_bn": { "type": "number", "const": 17.5158 },
        "hidden_software_bn_range": { "$ref": "#/$defs/ascending_pair" },
        "avoided_markdown_20pct_bn_range": { "$ref": "#/$defs/ascending_pair" },
        "preserved_base_fee_1_5pct_m_range": { "$ref": "#/$defs/ascending_pair" },
        "preserved_owl_market_cap_22x_m_range": { "$ref": "#/$defs/ascending_pair" },
        "preserved_owl_market_cap_range_m_range": { "$ref": "#/$defs/ascending_pair" },
        "fre_multiple_range": { "$ref": "#/$defs/ascending_pair" },
        "fre_margin_pct_range": { "$ref": "#/$defs/ascending_pair" }
      }
    },
    "eq4_section_36b_effective_cash_fee_rate": {
      "type": "object",
      "description": "EQ-4: effective = nominal / (1 - pik_share); 17.5% / 0.75 = 23.33% and 20.0% / 0.75 = 26.67%, against a $690.4M combined FY2025 disgorgement cap.",
      "additionalProperties": false,
      "required": ["nominal_incentive_rate_pct_range", "pik_share_pct", "effective_cash_incentive_rate_pct_range", "effective_rate_gross_up_pts_range", "obdc_fees_2021_m", "obdc_fees_2025_m", "obdc_base_fee_2025_m", "obdc_incentive_fee_2025_m", "obdc_fee_growth_pct", "otf_fees_2021_m", "otf_fees_2025_m", "otf_fee_growth_pct", "combined_fees_2021_m", "combined_fees_2025_m", "combined_fee_delta_m", "combined_fee_growth_pct", "section_36b_fy2025_disgorgement_cap_m", "pik_attributable_disgorgement_cap_m", "otf_obdc_overlap_min_pct"],
      "properties": {
        "nominal_incentive_rate_pct_range": { "$ref": "#/$defs/ascending_pair" },
        "pik_share_pct": { "type": "number", "const": 25.0 },
        "effective_cash_incentive_rate_pct_range": { "$ref": "#/$defs/ascending_pair" },
        "effective_rate_gross_up_pts_range": { "$ref": "#/$defs/ascending_pair" },
        "obdc_fees_2021_m": { "type": "number", "const": 282.4 },
        "obdc_fees_2025_m": { "type": "number", "const": 414.4 },
        "obdc_base_fee_2025_m": { "type": "number", "const": 252.1 },
