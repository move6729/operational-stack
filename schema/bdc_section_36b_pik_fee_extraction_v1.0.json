        "obdc_fee_growth_pct": { "type": "number", "const": 46.74 },
        "otf_fees_2021_m": { "type": "number", "const": 95.0 },
        "otf_fees_2025_m": { "type": "number", "const": 276.0 },
        "otf_fee_growth_pct": { "type": "number", "const": 190.53 },
        "combined_fees_2021_m": { "type": "number", "const": 377.4 },
        "combined_fees_2025_m": { "type": "number", "const": 690.4 },
        "combined_fee_delta_m": { "type": "number", "const": 313.0 },
        "combined_fee_growth_pct": { "type": "number", "const": 82.94 },
        "section_36b_fy2025_disgorgement_cap_m": { "type": "number", "const": 690.4, "description": "Combined OBDC + OTF FY2025 fee stack bounding the Section 36(b) disgorgement surface." },
        "pik_attributable_disgorgement_cap_m": { "type": "number", "const": 172.6 },
        "otf_obdc_overlap_min_pct": { "type": "number", "const": 70.0 }
      }
    },
    "cross_held_tranche_stack": {
      "type": "object",
      "description": "Combined OBDC + OTF cross-held software tranche stack: $291.263M of claim against $177.264M of reported fair value.",
      "additionalProperties": false,
      "required": ["total_claim_m", "total_claim_usd", "aggregate_fair_value_m", "aggregate_mark_pct", "tranches", "mark_vs_waterfall_divergence", "max_abs_divergence_m"],
      "properties": {
        "total_claim_m": { "type": "number", "const": 291.263 },
        "total_claim_usd": { "type": "number", "const": 291263000.0 },
        "aggregate_fair_value_m": { "type": "number", "const": 177.264 },
        "aggregate_mark_pct": { "type": "number", "const": 60.8605 },
        "tranches": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/stack_tranche" } },
        "mark_vs_waterfall_divergence": { "type": "array", "minItems": 5, "maxItems": 5, "description": "Per-tranche reported mark less sequential-waterfall recovery at ev = $177.264M; the vector sums to zero (aggregate conservation) while individual tranches diverge by up to $53.013M.", "items": { "$ref": "#/$defs/divergence_row" } },
        "max_abs_divergence_m": { "type": "number", "const": 53.013 }
      }
    },
    "stack_tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tranche", "borrower", "terms", "seniority", "claim_basis", "claim_m", "fair_value_m", "mark_pct", "breakeven_ev_m"],
      "properties": {
        "tranche": { "type": "string", "minLength": 4 },
        "borrower": { "type": "string", "minLength": 4 },
        "terms": { "type": "string", "minLength": 4 },
        "seniority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "claim_basis": { "type": "string", "enum": ["par", "cost"] },
        "claim_m": { "type": "number", "exclusiveMinimum": 0 },
        "fair_value_m": { "type": "number", "minimum": 0 },
        "mark_pct": { "type": "number", "minimum": 0, "maximum": 105 },
        "breakeven_ev_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 291.263, "description": "Cumulative claim boundary: the enterprise value at which this tranche reaches 100 cents on the dollar." }
      }
    },
    "divergence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tranche", "reported_fair_value_m", "waterfall_recovery_m", "divergence_m"],
      "properties": {
        "tranche": { "type": "string", "minLength": 4 },
        "reported_fair_value_m": { "type": "number", "minimum": 0 },
        "waterfall_recovery_m": { "type": "number", "minimum": 0 },
        "divergence_m": { "type": "number", "minimum": -291.263, "maximum": 291.263 }
      }
    },
    "tranche_recovery_waterfall": {
      "type": "object",
      "description": "Parameterized tranche_recovery(ev) evaluated at the three governing boundary regimes.",
      "additionalProperties": false,
      "required": ["at_zero_ev", "at_aggregate_fair_value", "at_total_claim"],
      "properties": {
        "at_zero_ev": { "$ref": "#/$defs/waterfall_result" },
        "at_aggregate_fair_value": { "$ref": "#/$defs/waterfall_result" },
        "at_total_claim": { "$ref": "#/$defs/waterfall_result" }
      }
    },
    "waterfall_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ev_m", "ev_usd", "total_claim_m", "total_recovery_m", "total_recovery_usd", "stack_cents_on_dollar", "fulcrum_tranche", "unrecovered_ev_m", "tranches"],
      "properties": {
        "ev_m": { "type": "number", "minimum": 0 },
        "ev_usd": { "type": "number", "minimum": 0 },
        "total_claim_m": { "type": "number", "const": 291.263 },
        "total_recovery_m": { "type": "number", "minimum": 0, "maximum": 291.263 },
        "total_recovery_usd": { "type": "number", "minimum": 0 },
        "stack_cents_on_dollar": { "type": "number", "minimum": 0, "maximum": 100 },
        "fulcrum_tranche": { "type": ["string", "null"], "description": "First tranche recovering strictly between 0 and its full claim; null at the zero-EV and full-claim boundaries." },
        "unrecovered_ev_m": { "type": "number", "minimum": 0 },
        "tranches": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/waterfall_tranche" } }
      }
    },
    "waterfall_tranche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tranche", "borrower", "seniority", "claim_basis", "claim_m", "claim_usd", "breakeven_ev_m", "recovery_m", "recovery_usd", "cents_on_dollar"],
      "properties": {
        "tranche": { "type": "string", "minLength": 4 },
        "borrower": { "type": "string", "minLength": 4 },
        "seniority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "claim_basis": { "type": "string", "enum": ["par", "cost"] },
        "claim_m": { "type": "number", "exclusiveMinimum": 0 },
        "claim_usd": { "type": "number", "exclusiveMinimum": 0 },
        "breakeven_ev_m": { "type": "number", "exclusiveMinimum": 0 },
        "recovery_m": { "type": "number", "minimum": 0 },
        "recovery_usd": { "type": "number", "minimum": 0 },
        "cents_on_dollar": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "peer_schedule_of_investments": {
      "type": "object",
      "description": "Zero-rent public credit mosaic: Star Mountain, Bow River, Crescent BDC, Digital Alpha, and the distressed US tech book.",
      "additionalProperties": false,
