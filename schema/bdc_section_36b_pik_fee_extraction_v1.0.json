          "required": ["japonesque_sofr_spread_bps", "japonesque_cash_pct", "japonesque_pik_pct", "cmt_cash_spread_range_bps", "cmt_pik_spread_range_bps", "cmt_pik_toggle_premium_bps_range", "mpusa_pik_pct", "caregility_proactive_pik_pct"],
          "properties": {
            "japonesque_sofr_spread_bps": { "type": "integer", "const": 948 },
            "japonesque_cash_pct": { "type": "number", "const": 0.0 },
            "japonesque_pik_pct": { "type": "number", "const": 69.0 },
            "cmt_cash_spread_range_bps": { "$ref": "#/$defs/ascending_int_pair" },
            "cmt_pik_spread_range_bps": { "$ref": "#/$defs/ascending_int_pair" },
            "cmt_pik_toggle_premium_bps_range": { "$ref": "#/$defs/ascending_int_pair" },
            "mpusa_pik_pct": { "type": "number", "const": 12.91 },
            "caregility_proactive_pik_pct": { "type": "number", "const": 10.0 }
          }
        },
        "bow_river": {
