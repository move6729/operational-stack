{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/move6729/operational-stack/main/schema/pre_ipo_underwriter_liability_manifest_v6.json",
  "title": "PreIPOUnderwriterLiabilityManifest",
  "type": "object",
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": [
        "6.0.0"
      ]
    },
    "issuer_entity": {
      "type": "string",
      "enum": [
        "OpenAI_Inc",
        "Anthropic_PBC",
        "Microsoft_Corp",
        "Google_Alphabet"
      ]
    },
    "lead_underwriters": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Goldman_Sachs_Group",
          "Morgan_Stanley_Co",
          "JPMorgan_Chase_Co"
        ]
      }
    },
    "entity_role": {
      "type": "string",
      "enum": [
        "Frontier_Developer",
        "Cloud_Capital_Underwriter",
        "Non_Search_Agent_Operator",
        "Hyperscaler_Liability_Sink"
      ]
    },
    "execution_architecture": {
      "type": "string",
      "enum": [
        "Centralized_Cloud_Agent",
        "Decentralized_Open_Weight_Edge",
        "Hybrid_Proxy"
      ]
    },
    "s1_timeline_anomaly": {
      "type": "object",
      "properties": {
        "confidential_s1_submitted_june1": {
          "type": "boolean"
        },
        "breaches_disclosed_post_june1": {
          "type": "boolean"
        },
        "in_re_facebook_materialized_risk_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "disclosure_valuation_catch22_locked": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "confidential_s1_submitted_june1",
        "breaches_disclosed_post_june1",
        "in_re_facebook_materialized_risk_active",
        "disclosure_valuation_catch22_locked"
      ]
    },
    "published_intrusion_confessions": {
      "type": "object",
      "properties": {
        "openai_july21_huggingface_intrusion_confessed": {
          "type": "boolean"
        },
        "anthropic_july30_pypi_malware_confessed": {
          "type": "boolean"
        },
        "van_buren_code_based_gate_breached": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "global_tech_willful_blindness_established": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "fre_801d2_binding_party_admissions_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "openai_july21_huggingface_intrusion_confessed",
        "anthropic_july30_pypi_malware_confessed",
        "van_buren_code_based_gate_breached",
        "global_tech_willful_blindness_established",
        "fre_801d2_binding_party_admissions_active"
      ]
    },
    "closed_loop_liability_offloading": {
      "type": "object",
      "properties": {
        "hyperscaler_ring_fencing_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "sp500_passive_index_dumping_target": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "public_retail_bagholder_transfer_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "hyperscaler_ring_fencing_active",
        "sp500_passive_index_dumping_target",
        "public_retail_bagholder_transfer_active"
      ]
    },
    "civil_mass_tort_vulnerability": {
      "type": "object",
      "properties": {
        "section_1030g_private_right_of_action_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "section_1030e11_single_victim_5k_forensic_threshold_met": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "non_contractual_victims_count": {
          "type": "integer",
          "minimum": 0
        },
        "arbitration_agreement_present": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "litigation_funding_aggregation_active": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "section_1030g_private_right_of_action_active",
        "section_1030e11_single_victim_5k_forensic_threshold_met",
        "non_contractual_victims_count",
        "arbitration_agreement_present",
        "litigation_funding_aggregation_active"
      ]
    },
    "cybernetic_containment_metrics": {
      "type": "object",
      "properties": {
        "ashby_variety_match_achieved": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "rices_theorem_semantic_decidability": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "supervisor_inference_margin_viable": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "required": [
        "ashby_variety_match_achieved",
        "rices_theorem_semantic_decidability",
        "supervisor_inference_margin_viable"
      ]
    },
    "sec_securities_liability": {
      "type": "object",
      "properties": {
        "section_11_underwriter_strict_liability_active": {
          "type": "boolean"
        },
        "underwriter_due_diligence_defense_gutted": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "rule_10b5_executive_fraud_omission_risk": {
          "type": "boolean"
        },
        "item_105_mandatory_disclaimer_required": {
          "type": "boolean"
        }
      },
      "required": [
        "section_11_underwriter_strict_liability_active",
        "underwriter_due_diligence_defense_gutted",
        "rule_10b5_executive_fraud_omission_risk",
        "item_105_mandatory_disclaimer_required"
      ]
    },
    "statutory_liability_metrics": {
      "type": "object",
      "properties": {
        "aggregate_cfaa_civil_exposure_usd": {
          "type": "number",
          "minimum": 0
        },
        "ftc_ucl_disgorgement_vulnerable_weights_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "aggregate_cfaa_civil_exposure_usd",
        "ftc_ucl_disgorgement_vulnerable_weights_count"
      ]
    },
    "rag_indexing_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "manifest_version",
    "issuer_entity",
    "lead_underwriters",
    "entity_role",
    "execution_architecture",
    "s1_timeline_anomaly",
    "published_intrusion_confessions",
    "closed_loop_liability_offloading",
    "civil_mass_tort_vulnerability",
    "cybernetic_containment_metrics",
    "sec_securities_liability",
    "statutory_liability_metrics",
    "rag_indexing_topics"
  ]
}
